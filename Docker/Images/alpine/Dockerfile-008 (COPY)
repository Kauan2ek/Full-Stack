ARG ALPINE_VERSION="3.19.0"

# FROM alpine:3.19.0
FROM alpine:${ALPINE_VERSION}

ENV DESENVOLVEDOR="Kauan Dias"

RUN <<EOF
    apk add --no-cache nodejs
    apk add --no-cache npm
    apk add --no-cache git
    apk add --no-cache nano
    apk add --no-cache unzip
EOF

# Adiciona um usuário no SO (Linux distro Alpine)
RUN adduser -D kauan \
    && addgroup dev \
    && addgroup kauan dev

# Define o usuário responsável pela execução dos próximos RUNs
USER kauan 

LABEL desenvolvedor=${DESENVOLVEDOR} \
      descricao="Imagem criada para exemplificar  a utilização de Labels no Dockerfile" \
      versao="1.0" \
      contato="+55 17 98293-8123"


# Sintaxe alternativa sem o "="
ARG FRONT_PRD="https://www.frontendpractices.com"
ARG BACK_PRD="https://www.meuapp.com.br:3002"


ENV FRONT_PRD=${FRONT_PRD}
ENV BACK_PRD=${BACK_PRD}
ENV VERSAO="1.0.1"


ENV MSG "Variável de ambiente criada no Dockerfile"
RUN echo ${MSG} > /tmp/arquivo_criado_durante_o_build_da_imagem.txt


# COPY /archives/arquivo_abc.txt /tmp/teste_copy/
# COPY /archives/arquivo_xyz.txt /tmp/teste_copy/
# COPY --chown=kauan:dev --chmod=777 /archives/arquivo_123.txt /tmp/teste_copy/

# Melhorando a performance do build, copiando os arquivos em um único comando
# COPY --chown=kauan:dev ./archives/arquivo_* /tmp/copy_curinga/
# COPY --chown=kauan:dev ./archives/arquivo_ab?.??? /tmp/copy_curinga/


COPY --chown=kauan:dev archives/arquivos.zip /tmp/arquivos/files.zip
RUN cd /tmp/arquivos/ \
    && unzip files.zip \
    && rm files.zip


ADD --chown=kauan:dev https://argus-academy.com/cursos/docker_-_dominando_a_criacao_e_o_gerenciamento_de_containers/server.tar.gz /opt/app/

RUN cd /opt/app/ \
    && tar -xzf server.tar.gz \
    && rm server.tar.gz

COPY ./archives/arquivo_123.txt ./archives/arquivo_abc.txt ./archives/*.???? /tmp/copy_mult/
COPY . ./tmp/copy_all/ 

