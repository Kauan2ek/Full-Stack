ARG ALPINE_VERSION="3.19.0"

# FROM alpine:3.19.0
FROM alpine:${ALPINE_VERSION}

ENV DESENVOLVEDOR="Kauan Dias"

RUN <<EOF
    apk add --no-cache nodejs
    apk add --no-cache npm
    apk add --no-cache git
    apk add --no-cache nano
EOF

# Adiciona um usuário no SO (Linux distro Alpine)
RUN adduser -D kauan

# Define o usuário responsável pela execução dos próximos RUNs
USER kauan

LABEL desenvolvedor=${DESENVOLVEDOR} \
      descricao="Imagem criada para exemplificar  a utilização de Labels no Dockerfile" \
      versao="1.0" \
      contato="+55 17 98293-8123"


# Sintaxe alternativa sem o "="
ARG FRONT_PRD="https://www.frontendpractices.com"
ARG BACK_PRD="https://www.meuapp.com.br:3002"


ENV FRONT_PRD=${FRONT_PRD}
ENV BACK_PRD=${BACK_PRD}
ENV VERSAO="1.0.1"


ENV MSG "Variável de ambiente criada no Dockerfile"
RUN echo ${MSG} > /tmp/arquivo_criado_durante_o_build_da_imagem.txt

# O comando CMD é usado para especificar o comando padrão a ser executado quando um contêiner é iniciado a partir da imagem. Ele pode ser substituído por um comando diferente durante a execução do contêiner, mas se nenhum comando for fornecido, o CMD será executado por padrão. No exemplo abaixo, o CMD é definido para executar um comando simples que imprime "Hello, World!" no terminal quando o contêiner é iniciado.
CMD ["/bin/sh", "-c", "echo Hello, World!"]
# Cada Dockerfile possui apenas um único CMD, o último sempre será o válido.
# O CMD não é executado durante o processo de construção da imagem, mas sim quando um contêiner é iniciado a partir dessa imagem. Ele serve como um comando padrão para o contêiner, mas pode ser substituído por um comando diferente durante a execução do contêiner. Portanto, o CMD é relevante apenas no momento da execução do contêiner e não durante a construção da imagem.