ARG ALPINE_VERSION="3.19.0"

FROM alpine:${ALPINE_VERSION}

WORKDIR /
RUN mkdir ./logs/
RUN echo "1 - Diretório de trabalho atual: $(pwd)" > /logs/1.txt

RUN <<EOF
  apk add --no-cache nodejs
  apk add --no-cache npm
EOF

WORKDIR /opt/
RUN echo "2 - Diretório de trabalho atual: $(pwd)" > /logs/2.txt

ADD https://argus-academy.com/cursos/docker_-_dominando_a_criacao_e_o_gerenciamento_de_containers/server.tar.gz ./code/

WORKDIR /opt/code/
RUN echo "3 - Diretório de trabalho atual: $(pwd)" > /logs/3.txt

RUN tar -xzf server.tar.gz \
    && rm server.tar.gz


# Cada Dockerfile possui apenas um único CMD
ENTRYPOINT ["node"]
CMD ["server.js"]


# EXPOSE 3000 por padrão será tcp
EXPOSE 3000/tcp
EXPOSE 3000/udp

EXPOSE 3030
# Normalmente o EXPOSE é utilizado para documentar quais portas a aplicação utiliza, mas não é obrigatório. O Docker não bloqueia ou libera portas automaticamente, isso deve ser feito no momento de criar o container utilizando a flag -p ou -P.
# Também é comum que apenas uma porta e exposta por container.

# Flag -P usa a porta indicada no EXPOSE.
